{
  "version": 1,
  "name": "supervisor-cryptonight",
  "backend": "verilator",
  "prepare": {
    "cwd": "../..",
    "command": ["./build_all.sh"]
  },
  "images": {
    "base": "../../build/kernel/auto/axi_ram.mif",
    "ext": "none"
  },
  "plusargs": {
    "supervisor_entry": {
      "symbol": "UTEST_CRYPTONIGHT",
      "file": "../../build/kernel/auto/utest_symbols.txt"
    },
    "max_time": 5000000000000,
    "dump_ext_size": 0,
    "compare_ext_addr": 0,
    "compare_ext_file": {
      "path": "../../build/utility/crypto/crypto.bin"
    }
  },
  "flags": ["no_ext_ram_write_log"]
}
